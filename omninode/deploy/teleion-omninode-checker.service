[Unit]
Description=Teleion Fabric OmniNode feed maintenance: independent check (a different worker and Fabric key)
Documentation=file:///opt/teleion/omninode/omninode_live/run_checker.py
After=network-online.target teleion-omninode-maker.service
Wants=network-online.target teleion-omninode-maker.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/eranos-worker/reviewer2.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/teleion/omninode:/opt/teleion/omninode/.deps:/opt/teleion/notes:/opt/teleion/eranos
Environment=OMNINODE_CHECKER_KEY_ID=set-at-deploy
WorkingDirectory=/opt/teleion/omninode
ExecStart=/opt/teleion/eranos/.venv/bin/python -m omninode_live.run_checker
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=512M
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
TimeoutStartSec=1500
