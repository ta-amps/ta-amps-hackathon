[Unit]
Description=Teleion Fabric OmniNode feed maintenance: tuner step from recorded outcomes (no model call)
Documentation=file:///opt/teleion/omninode/omninode_live/run_tuner.py
After=network-online.target teleion-omninode-checker.service
Wants=network-online.target teleion-omninode-checker.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/eranos-worker/planner.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/teleion/omninode:/opt/teleion/omninode/.deps:/opt/teleion/notes:/opt/teleion/eranos
Environment=OMNINODE_CHECKER_KEY_ID=set-at-deploy
WorkingDirectory=/opt/teleion/omninode
ExecStart=/opt/teleion/eranos/.venv/bin/python -m omninode_live.run_tuner
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=512M
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
TimeoutStartSec=1500
