# Settings for deploy/bootstrap-hosting.sh (copy to deploy/hosting.env). KEY=value lines; names only, never a secret.
APP=my-app-api
VOLUME=my_app_data
VOLUME_GB=1
FLY_ORG=personal
FLY_REGION=iad
# The edge secret's name on Fly; the Worker always calls it EDGE_SECRET.
EDGE_SECRET_NAME=MY_APP_EDGE_SECRET
EDGE_CONFIG=deploy/cloudflare/wrangler.jsonc
# Secrets typed with hidden input, space-separated; Enter skips one.
PROMPT_SECRETS=MODEL_API_KEY
# Optional: one subdomain under a single shared domain in Cloudflare (for example app.example.org).
CUSTOM_DOMAIN=
HEALTH_URL=https://my-app.<your-subdomain>.workers.dev/health
GITHUB_REPO=<owner>/<repo>
